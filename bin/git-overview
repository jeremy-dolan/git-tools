#!/usr/bin/env python3
"""git-overview — one-screen bird's-eye view of local git state.

Strictly read-only: never fetches, writes refs, or refreshes the index.
Remote advertisements confirm whether locally computed counts are current.
Requires Python 3.8+ and Git; authenticated GitHub CLI (gh) is optional.

Usage: git-overview [--no-check-remote] [--no-github] [-n N | --all-branches]
                    [--color[=WHEN]] [--no-color] [--help]

 --no-check-remote  skip the upstream freshness check
 --no-github        skip the GitHub PR and issue lookup
 -n N               show at most N branches (default = 12, 0 for no limit)
 --all-branches     same as -n 0
 --color[=WHEN]     always, never, or auto (default auto; bare --color = always)
 --no-color         same as --color=never

The branch cap defaults to 12, or $GIT_OVERVIEW_BRANCH_LIMIT if set. Branches
are ordered most-recently-committed first; the checked-out branch is always
shown regardless. Put git-overview on PATH, then call it as git overview.
"""

from dataclasses import dataclass, field
from datetime import datetime
import json
import os
from pathlib import Path
import re
import shutil
import signal
import subprocess
import sys
import time


@dataclass
class Options:
    check_remote: bool = True
    github_skipped: str = ""
    branch_limit: int = 12
    color: str = "auto"


def parse_options(args):
    options = Options()
    limit = os.environ.get("GIT_OVERVIEW_BRANCH_LIMIT") or "12"
    args = iter(args)
    for arg in args:
        if arg == "--no-github":
            options.github_skipped = arg
        elif arg == "--no-check-remote":
            options.check_remote = False
        elif arg == "--all-branches":
            limit = "0"
        elif arg == "-n":
            limit = next(args, None)
            if limit is None:
                raise ValueError("-n requires a branch limit")
        elif arg == "--color":
            options.color = "always"
        elif arg == "--no-color":
            options.color = "never"
        elif arg.startswith("--color="):
            options.color = arg.partition("=")[2]
            if options.color not in ("always", "never", "auto"):
                raise ValueError("invalid --color value " + options.color
                                 + " (want always, never, or auto)")
        elif arg in ("-h", "--help"):
            print(__doc__)
            return None
        else:
            raise ValueError("unknown option " + arg)
    try:
        options.branch_limit = int(limit)
    except ValueError:
        raise ValueError("invalid branch limit " + limit + " (want a nonnegative integer)")
    if options.branch_limit < 0:
        raise ValueError("invalid branch limit " + limit + " (want a nonnegative integer)")
    return options


@dataclass
class Result:
    data: bytes = b""
    ok: bool = False
    timed_out: bool = False

    def text(self):
        # Remove the command's terminator, not newlines belonging to a path.
        return os.fsdecode(self.data[:-1] if self.data.endswith(b"\n") else self.data) if self.ok else ""


def run(args, env=None, timeout=None):
    """Capture bytes; failures and timeouts must never masquerade as emptiness."""
    try:
        with subprocess.Popen(args, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                              stderr=subprocess.DEVNULL, env=env,
                              start_new_session=(os.name == "posix")) as process:
            try:
                data, _ = process.communicate(timeout=timeout)
                return Result(data, process.returncode == 0)
            except subprocess.TimeoutExpired:
                # Git/gh may have spawned SSH or a credential helper holding
                # stdout open. Kill the session's process group before reaping.
                if os.name == "posix":
                    os.killpg(process.pid, signal.SIGKILL)
                else:
                    process.kill()
                process.communicate()
                return Result(timed_out=True)
    except OSError:
        return Result()


def network_env():
    return dict(os.environ, GIT_TERMINAL_PROMPT="0", GCM_INTERACTIVE="never",
                GIT_ASKPASS="", SSH_ASKPASS="", GH_PROMPT_DISABLED="1",
                GIT_SSH_COMMAND=(os.environ.get("GIT_SSH_COMMAND") or "ssh")
                + " -o BatchMode=yes")


class Git:
    def __init__(self):
        # NO_LAZY_FETCH also prevents implicit object downloads in partial clones.
        self.env = dict(os.environ, GIT_OPTIONAL_LOCKS="0", GIT_NO_LAZY_FETCH="1")

    def run(self, *args, timeout=None, env=None):
        # Avoid status refreshing the on-disk index or running a configured
        # fsmonitor program: both would violate the read-only contract.
        return run(["git", "--no-optional-locks", "-c", "core.fsmonitor=false", *args],
                   env=dict(self.env, **(env or {})), timeout=timeout)

    def text(self, *args):
        return self.run(*args).text()

    def status(self, path=None):
        args = ["-C", path] if path is not None else []
        return parse_status(self.run(*args, "status", "--porcelain=v1", "-z",
                                     "--untracked-files=normal"))


def visible(text):
    """Keep control characters and undecodable filename bytes out of the layout."""
    return "".join({"\n": r"\n", "\r": r"\r", "\t": r"\t"}.get(c,
                   "\\x%02x" % (ord(c) - 0xdc00) if 0xdc80 <= ord(c) <= 0xdcff
                   else "\\x%02x" % ord(c) if ord(c) < 32 or ord(c) == 127 else c)
                   for c in text)


def records(result, count, ref_format=False):
    """for-each-ref terminates with NUL+LF; log -z uses NUL alone.

    Fields also use NUL, which Git ref names and normal commit text cannot
    contain. Never split on pipes, whitespace, or Unicode line separators.
    """
    if not result.ok:
        return None
    if not result.data:
        return []
    if ref_format:
        rows = [row.split(b"\0") for row in result.data.split(b"\0\n")[:-1]]
        if not result.data.endswith(b"\0\n"):
            return None
    else:
        fields = result.data.split(b"\0")
        if fields.pop() != b"" or len(fields) % count:
            return None
        rows = [fields[i:i + count] for i in range(0, len(fields), count)]
    if any(len(row) != count for row in rows):
        return None
    return [[os.fsdecode(value) for value in row] for row in rows]


@dataclass
class Status:
    ok: bool = True
    staged: int = 0
    unstaged: int = 0
    untracked: int = 0
    tracked: int = 0
    conflicts: list = field(default_factory=list)


def parse_status(result):
    status = Status(ok=result.ok)
    if not result.ok:
        return status
    fields = iter(result.data.split(b"\0"))
    for entry in fields:
        if not entry:
            continue
        if len(entry) < 4 or entry[2:3] != b" ":
            return Status(ok=False)
        code, path = entry[:2], os.fsdecode(entry[3:])
        if code == b"??":
            status.untracked += 1
        elif code in (b"DD", b"AU", b"UD", b"UA", b"DU", b"AA", b"UU"):
            status.conflicts.append(code.decode() + " " + visible(path))
        else:
            status.staged += code[:1] != b" "
            status.unstaged += code[1:] != b" "
            status.tracked += 1
            # -z renames/copies have a second pathname, not a status record.
            if b"R" in code or b"C" in code:
                if next(fields, None) is None:
                    return Status(ok=False)
    return status


@dataclass
class Worktree:
    path: str
    ref: str = ""
    sha: str = ""
    bare: bool = False
    locked: bool = False
    prunable: bool = False
    status: Status = None
    missing: bool = False


def collect_worktrees(git):
    result = git.run("worktree", "list", "--porcelain", "-z")
    if not result.ok:
        return None
    trees = []
    tree = None
    for entry in result.data.split(b"\0"):
        key, _, value = entry.partition(b" ")
        if key == b"worktree":
            tree = Worktree(os.fsdecode(value))
            trees.append(tree)
        elif tree is not None:
            if key == b"HEAD":
                tree.sha = value.decode("ascii")
            elif key == b"branch":
                tree.ref = os.fsdecode(value[11:] if value.startswith(b"refs/heads/") else value)
            elif key == b"detached":
                tree.ref = "(detached)"
            elif key == b"bare":
                tree.ref, tree.bare = "(bare)", True
            elif key == b"locked":
                tree.locked = True
            elif key == b"prunable":
                tree.prunable = True
    if len(trees) > 1:
        for tree in trees:
            tree.sha = git.text("rev-parse", "--short", tree.sha) if tree.sha.strip("0") else ""
            tree.missing = not os.path.isdir(tree.path)
            if not tree.bare and not tree.missing:
                tree.status = git.status(tree.path)
    return trees


def collect_config(git):
    # %(upstream) is empty both when no upstream is configured and when the
    # remote or its fetch refspec cannot map it to a tracking ref.
    result = git.run("config", "--null", "--get-regexp", r"^branch\..*\.(remote|merge)$")
    config = {}
    for entry in result.data.split(b"\0"):
        key, separator, value = entry.partition(b"\n")
        if separator:
            name, _, kind = os.fsdecode(key)[7:].rpartition(".")
            config.setdefault(name, {}).setdefault(kind, os.fsdecode(value))
    return config


@dataclass
class Head:
    branch: str
    has_remote: bool
    upstream: str
    remote: str
    merge: str
    description: str
    commit: list
    operations: list
    counts: tuple = None
    fetch_ts: int = None
    remote_state: str = ""


def read_file(path):
    try:
        return path.read_text(errors="replace").rstrip("\n")
    except OSError:
        return ""


def collect_head(git, options):
    directory = Path(git.text("rev-parse", "--absolute-git-dir"))
    common = Path(git.text("rev-parse", "--path-format=absolute", "--git-common-dir"))
    branch = git.text("symbolic-ref", "--quiet", "--short", "HEAD")
    # Keep the configured upstream too: @{upstream} cannot resolve a tracking
    # ref that was deleted or has never been fetched here.
    head = Head(branch, bool(git.text("remote")),
                git.text("rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{upstream}"),
                git.text("config", "--get", "branch." + branch + ".remote") if branch else "",
                git.text("config", "--get", "branch." + branch + ".merge") if branch else "",
                git.text("describe", "--all", "--always", "HEAD") if not branch else "",
                records(git.run("log", "-1", "-z", "--format=%ct%x00%h%x00%s"), 3), [])
    if (directory / "rebase-merge").is_dir():
        step = read_file(directory / "rebase-merge/msgnum")
        total = read_file(directory / "rebase-merge/end")
        onto = read_file(directory / "rebase-merge/head-name")
        if onto.startswith("refs/heads/"):
            onto = onto[11:]
        head.operations.append("REBASE in progress" + (f" ({step}/{total})" if step else "")
                               + (" — rebasing " + onto if onto else ""))
    if (directory / "rebase-apply").is_dir():
        head.operations.append("REBASE/AM in progress")
    for marker, label in (("MERGE_HEAD", "MERGE"), ("CHERRY_PICK_HEAD", "CHERRY-PICK"),
                          ("REVERT_HEAD", "REVERT")):
        if (directory / marker).is_file():
            head.operations.append(label + " in progress")
    if (common / "BISECT_LOG").is_file():
        head.operations.append("BISECT in progress")
    try:
        fetch = (common / "FETCH_HEAD").stat()
        # A fetch that obtained no refs can leave an empty, freshly stamped
        # file; its timestamp alone is not evidence of fetched remote refs.
        if head.has_remote and fetch.st_size:
            head.fetch_ts = int(fetch.st_mtime)
    except OSError:
        pass
    if head.upstream:
        result = git.run("rev-list", "--left-right", "--count", head.upstream + "...HEAD")
        if result.ok:
            try:
                behind, ahead = map(int, result.data.split())
                head.counts = behind, ahead
            except ValueError:
                pass
    if options.check_remote and head.remote and head.merge:
        have = git.text("rev-parse", "--verify", "--quiet", "refs/remotes/" + head.upstream) if head.upstream else ""
        # ls-remote reads advertised refs without downloading objects, moving
        # refs, or writing FETCH_HEAD. fetch --dry-run can still download
        # objects, so it is unsuitable for this read-only freshness check.
        result = git.run("ls-remote", "--quiet", head.remote, head.merge,
                         timeout=5, env=network_env())
        advertised = {}
        malformed = False
        for line in result.data.split(b"\n"):
            if not line:
                continue
            oid, separator, ref = line.partition(b"\t")
            if not separator or not re.fullmatch(rb"[0-9a-fA-F]{40}|[0-9a-fA-F]{64}", oid):
                malformed = True
            else:
                advertised[os.fsdecode(ref)] = oid.decode()
        if not result.ok or malformed:
            head.remote_state = "error"
        elif head.merge not in advertised:
            head.remote_state = "gone"
        elif not have:
            head.remote_state = "unfetched"
        else:
            head.remote_state = "same" if advertised[head.merge] == have else "moved"
    return head


GITHUB_QUERY = """
query($owner: String!, $name: String!) {
  repository(owner: $owner, name: $name) {
    pullRequests(first: 15, states: OPEN,
      orderBy: {field: CREATED_AT, direction: DESC}) {
      nodes {
        number title headRefName isDraft reviewDecision
        commits(last: 1) {
          nodes { commit { statusCheckRollup { state } } }
        }
      }
    }
    issues(first: 1, states: OPEN,
      orderBy: {field: CREATED_AT, direction: DESC}) {
      totalCount
      nodes { number title createdAt }
    }
  }
}
"""


@dataclass
class GitHubOverview:
    state: str
    prs: list = field(default_factory=list)
    issue_count: int = 0
    newest_issue: dict = None


def parse_github(data):
    # Keep the GraphQL envelope: partial data accompanied by errors must not
    # turn failed lookups into "no checks", "(none)", or "0 open".
    payload = json.loads(data)
    if not isinstance(payload, dict) or payload.get("errors"):
        raise ValueError("invalid GitHub data")
    repository = payload["data"]["repository"]
    rows = repository["pullRequests"]["nodes"]
    if not isinstance(rows, list):
        raise ValueError("invalid PR data")
    prs = []
    for row in rows:
        if (not isinstance(row, dict)
                or type(row.get("number")) is not int or row["number"] <= 0
                or type(row.get("isDraft")) is not bool
                or any(not isinstance(row.get(key), str) for key in ("title", "headRefName"))
                or "reviewDecision" not in row
                or (row["reviewDecision"] is not None and not isinstance(row["reviewDecision"], str))):
            raise ValueError("invalid PR data")
        commits = row["commits"]["nodes"]
        if not isinstance(commits, list) or len(commits) != 1:
            raise ValueError("invalid PR commit data")
        rollup = commits[0]["commit"]["statusCheckRollup"]
        ci = None if rollup is None else rollup["state"]
        if rollup is not None and not isinstance(ci, str):
            raise ValueError("invalid CI data")
        prs.append(dict(row, ci=ci))
    issues = repository["issues"]
    count, nodes = issues["totalCount"], issues["nodes"]
    if (type(count) is not int or count < 0 or not isinstance(nodes, list)
            or len(nodes) != min(count, 1)):
        raise ValueError("invalid issue data")
    newest = None
    if nodes:
        issue = nodes[0]
        if (not isinstance(issue, dict) or type(issue.get("number")) is not int
                or issue["number"] <= 0 or not isinstance(issue.get("title"), str)
                or not isinstance(issue.get("createdAt"), str)):
            raise ValueError("invalid issue data")
        created = datetime.fromisoformat(issue["createdAt"].replace("Z", "+00:00"))
        if created.tzinfo is None:
            raise ValueError("issue creation date has no timezone")
        newest = dict(issue, timestamp=int(created.timestamp()))
    return GitHubOverview("", prs, count, newest)


def collect_github(options, has_remote):
    if options.github_skipped:
        return GitHubOverview("skipped: " + options.github_skipped)
    if not shutil.which("gh"):
        return GitHubOverview("not checked: gh not installed")
    if not has_remote:
        return GitHubOverview("not checked: no remote configured")
    result = run(["gh", "api", "graphql", "-F", "owner={owner}", "-F", "name={repo}",
                  "-f", "query=" + GITHUB_QUERY],
                 env=network_env(), timeout=6)
    if result.timed_out:
        return GitHubOverview("not checked: gh timed out after 6s")
    if result.ok:
        try:
            return parse_github(result.data)
        except (ValueError, UnicodeError, KeyError, TypeError, OverflowError, OSError):
            pass
    return GitHubOverview("not checked: gh failed — invalid response, not authenticated, or no GitHub remote")


@dataclass
class BranchRow:
    name: str
    sync: str
    color: str
    timestamp: int
    sha: str
    subject: str
    upstream: str


def interpret_branches(refs, config, current, limit):
    rows, hidden = [], 0
    for name, timestamp, upstream, track, sha, subject in refs:
        if name != current and limit > 0 and len(rows) >= limit:
            hidden += 1
            continue
        settings = config.get(name, {})
        note = upstream if upstream != "origin/" + name else ""
        if not upstream:
            sync, color = ("⚠ remote", "red") if settings else ("(no up)", "dim")
            if settings.get("remote") and settings.get("merge"):
                merge = settings["merge"]
                note = settings["remote"] + "/" + (merge[11:] if merge.startswith("refs/heads/") else merge)
        elif track == "gone":
            sync, color = "⚠ gone", "yellow"
        elif not track:
            sync, color = "✓", "green"
        else:
            sync = " ".join(symbol + match.group(1) for word, symbol in
                            (("ahead", "↑"), ("behind", "↓"))
                            for match in [re.search(word + r" (\d+)", track)] if match)
            color = "yellow"
        rows.append(BranchRow(name, sync, color, int(timestamp), sha, subject, note))
    return rows, hidden


def clip(width, text, tail=False):
    width = max(4, width)
    if len(text) <= width:
        return text
    return "…" + text[-(width - 1):] if tail else text[:width - 1] + "…"


def age(timestamp, now):
    seconds = max(0, now - int(timestamp))
    for threshold, divisor, suffix in ((60, 1, "s"), (3600, 60, "m"),
                                       (86400, 3600, "h"), (2592000, 86400, "d"),
                                       (31536000, 2592000, "mo")):
        if seconds < threshold:
            return str(seconds // divisor) + suffix
    return str(seconds // 31536000) + "y"


def calendar(timestamp):
    return datetime.fromtimestamp(int(timestamp)).strftime("%Y-%m-%d")


class Renderer:
    def __init__(self, options):
        enabled = options.color == "always" or (options.color == "auto"
                    and sys.stdout.isatty() and not os.environ.get("NO_COLOR"))
        self.colors = {name: "\x1b[" + code + "m" if enabled else "" for name, code in
                       (("bold", "1"), ("dim", "2"), ("reset", "0"), ("red", "31"),
                        ("green", "32"), ("yellow", "33"), ("blue", "34"),
                        ("magenta", "35"), ("cyan", "36"))}
        self.cols = max(60, min(120, shutil.get_terminal_size((80, 24)).columns))
        self.now = int(time.time())

    def c(self, text, *colors):
        return "".join(self.colors[color] for color in colors) + text + self.colors["reset"]

    def section(self, title):
        print("\n" + self.c(" " + title + " " + "─" * max(0, self.cols - len(title) - 4), "bold", "cyan"))

    def field(self, label, main, plain=None, note="", note_plain="", gap=3):
        line = "  " + self.c(label.ljust(9), "dim") + " " + main
        if not note_plain:
            print(line)
        elif 12 + len(plain) + gap + len(note_plain) <= self.cols:
            print(line + " " * gap + note)
        else:
            print(line + "\n" + " " * 12 + note)

    def none(self):
        print("  " + self.c("(none)", "dim"))

    def fail(self, reason):
        print("  " + self.c("(unavailable: " + reason + ")", "red"))

    def head(self, head):
        self.section("HEAD")
        for operation in head.operations:
            print("  " + self.c("⚑ " + visible(operation), "red", "bold"))
        clear = "" if head.operations else "(no rebase/merge/bisect in progress)"
        branch = visible(head.branch)
        plain = branch or "DETACHED HEAD   " + visible(head.description)
        main = self.c(branch, "bold") if branch else self.c("DETACHED HEAD", "red", "bold") + "   " + self.c(visible(head.description), "dim")
        self.field("branch", main, plain, self.c(clear, "dim"), clear)
        if head.commit:
            timestamp, sha, subject = head.commit[0]
            self.field("commit", self.c(sha, "yellow") + "  " + clip(self.cols - 30, visible(subject))
                       + "  " + self.c("(" + age(timestamp, self.now) + " ago)", "dim"))
        else:
            self.field("commit", self.c("no commits yet", "dim"))
        main, plain, note, note_plain = self.upstream(head)
        self.field("upstream", main, plain, note, note_plain, gap=2)

    def upstream(self, head):
        note, note_plain = "", ""
        if not head.branch:
            plain = "n/a while detached"
            main = self.c(plain, "dim")
        elif head.upstream:
            if head.counts is None:
                sync = "(ahead/behind unavailable)"
                colored = self.c(sync, "red", "bold")
            elif head.counts == (0, 0):
                sync, colored = "in sync", self.c("in sync", "green")
            else:
                behind, ahead = head.counts
                pieces = [(f"↑{ahead} ahead", "yellow")] if ahead else []
                if behind:
                    pieces.append((f"↓{behind} behind", "yellow"))
                sync = "  ".join(text for text, _ in pieces)
                colored = "  ".join(self.c(text, color) for text, color in pieces)
            plain = visible(head.upstream) + "  " + sync
            main = visible(head.upstream) + "  " + colored
            fetched = age(head.fetch_ts, self.now) if head.fetch_ts is not None else ""
            if head.remote_state == "same":
                note_plain = "(checked just now)"
                note = self.c(note_plain, "dim")
            elif head.remote_state in ("moved", "gone"):
                if head.remote_state == "gone":
                    message = visible(head.merge + " no longer exists on " + head.remote)
                    color = "red"
                else:
                    message = ("remote moved since your fetch " + fetched + " ago — counts stale" if fetched
                               else "remote has commits you have never fetched — counts stale")
                    color = "yellow"
                note_plain = "⚠ " + message
                note = self.c(note_plain, color)
            else:
                elapsed = self.now - head.fetch_ts if fetched else 0
                color = ("yellow",) if not fetched or elapsed > 86400 else ("dim",)
                message = "fetched " + fetched + " ago" if fetched else "never fetched"
                if fetched and elapsed > 604800:
                    message += " — stale"
                    color = ("red", "bold")
                if head.remote_state == "error":
                    message += "; remote unreachable"
                note_plain = "(" + message + ")"
                note = self.c(note_plain, *color)
        elif head.remote and head.merge:
            merge = head.merge[11:] if head.merge.startswith("refs/heads/") else head.merge
            target = visible(head.remote + "/" + merge)
            plain = target + "  no remote-tracking ref"
            main = target + "  " + self.c("no remote-tracking ref", "red")
            if head.remote_state in ("gone", "unfetched"):
                message, color = (("deleted on the remote", "red") if head.remote_state == "gone"
                                  else ("it exists on the remote — fetch to compare", "yellow"))
                note_plain = "⚠ " + message
                note = self.c("⚠", color, "bold") + self.c(" " + message, color)
            else:
                note_plain = "(deleted upstream, or never fetched here)"
                note = self.c(note_plain, "dim")
        else:
            plain = ("none — " + visible(head.branch) + " has never been pushed" if head.has_remote
                     else "none — no remote configured")
            main = self.c(plain, "dim")
        return main, plain, note, note_plain

    def status_summary(self, status, detailed=False):
        pieces = []
        if status.conflicts:
            count = len(status.conflicts)
            pieces.append(self.c(f"{count} conflict" + ("s" if count != 1 else ""), "red", "bold"))
        if detailed:
            if status.staged:
                pieces.append(f"{status.staged} staged")
            if status.unstaged:
                pieces.append(self.c(f"{status.unstaged} modified", "yellow"))
        elif status.tracked:
            pieces.append(self.c(f"{status.tracked} changed", "yellow"))
        if status.untracked:
            pieces.append(self.c(f"{status.untracked} untracked", "dim"))
        return ("   " if detailed else "  ").join(pieces) or self.c("clean", "green")

    def uncommitted(self, status):
        self.section("UNCOMMITTED")
        if not status.ok:
            self.fail("git status failed — working-tree state unknown")
            return
        print("  " + self.status_summary(status, detailed=True))
        for conflict in status.conflicts[:8]:
            print("    " + self.c(clip(self.cols - 6, conflict), "red"))
        if len(status.conflicts) > 8:
            print("    " + self.c(f"… {len(status.conflicts) - 8} more", "dim"))

    def branches(self, refs, config, current, limit, trees):
        self.section("BRANCHES")
        if refs is None:
            self.fail("git for-each-ref failed")
            return
        if not refs:
            self.none()
            return
        rows, hidden = interpret_branches(refs, config, current, limit)
        checked_out = {tree.ref for tree in trees or []}
        whens = [age(row.timestamp, self.now) + " ago" if self.now - row.timestamp < 604800
                 else calendar(row.timestamp) for row in rows]
        namew = min(21, max(6, *(len(visible(row.name)) for row in rows)))
        syncw = max(4, *(len(row.sync) for row in rows))
        whenw = max(6, *(len(when) for when in whens))
        shaw = max(3, *(len(row.sha) for row in rows))
        print("  " + self.c(f"{'BRANCH':<{namew}}  {'SYNC':<{syncw}} {'COMMIT':<{whenw}} {'SHA':<{shaw}} SUBJECT", "dim"))
        avail = self.cols - (namew + syncw + whenw + shaw + 7)
        for row, when in zip(rows, whens):
            mark = self.c("*", "green", "bold") if row.name == current else self.c("+", "cyan") if row.name in checked_out else " "
            subject, upstream = visible(row.subject), visible(row.upstream)
            rest = avail - len(upstream) - 3
            if upstream and rest > 4:
                tail = self.c("→" + upstream, "cyan") + "  " + self.c(clip(rest, subject), "dim")
            elif upstream:
                tail = self.c("→" + clip(avail - 1, upstream, tail=True), "cyan")
            else:
                tail = self.c(clip(avail, subject), "dim")
            print(mark + " " + clip(namew, visible(row.name), tail=True).ljust(namew)
                  + "  " + self.c(row.sync.ljust(syncw), row.color)
                  + " " + self.c(when.ljust(whenw), "dim")
                  + " " + self.c(row.sha.ljust(shaw), "yellow") + " " + tail)
        if hidden:
            print("  " + self.c(f"… {hidden} older branch(es) hidden — see them with -n 0", "dim"))

    def worktrees(self, trees, toplevel):
        self.section("WORKTREES")
        if trees is None:
            self.fail("git worktree list failed")
            return
        if len(trees) <= 1:
            print("  " + self.c("(just this one)", "dim"))
            return
        home = os.environ.get("HOME", "")
        paths = [visible("~" + tree.path[len(home):] if home and
                         (tree.path == home or tree.path.startswith(home + os.sep))
                         else tree.path) for tree in trees]
        refs = [(tree.sha or "—") + " (detached)" if tree.ref == "(detached)" else visible(tree.ref)
                for tree in trees]
        refw = max(len("BRANCH"), *(len(ref) if tree.ref == "(detached)" else min(21, len(ref))
                                          for tree, ref in zip(trees, refs)))
        pathw = min(max(8, *(len(path) for path in paths)), max(12, self.cols - refw - 30))
        print("  " + self.c(f"{'WORKTREE':<{pathw}}  {'BRANCH':<{refw}}  STATUS", "dim"))
        for tree, path, ref in zip(trees, paths, refs):
            if tree.bare:
                status = self.c("—", "dim")
            elif tree.missing:
                status = self.c("path is missing", "red")
            elif not tree.status.ok:
                status = self.c("(status failed)", "red")
            else:
                status = self.status_summary(tree.status)
            mark = self.c("*", "green", "bold") if tree.path == toplevel else " "
            marks = ("   " + self.c("[locked]", "yellow") if tree.locked else "")
            marks += "   " + self.c("[prunable]", "red") if tree.prunable else ""
            if tree.ref == "(detached)":
                ref_text = (self.c(tree.sha or "—", "yellow") + " " + self.c("(detached)", "dim")
                            + " " * (refw - len(ref)))
            else:
                ref_text = self.c(clip(refw, ref, tail=True).ljust(refw), "cyan")
            print(mark + " " + clip(pathw, path, tail=True).ljust(pathw)
                  + "  " + ref_text
                  + "  " + status + marks)

    def stashes(self, rows):
        self.section("STASHES")
        if rows is None:
            self.fail("git stash list failed")
        elif not rows:
            self.none()
        else:
            for ref, timestamp, message in rows:
                color = "red" if self.now - int(timestamp) > 604800 else "dim"
                when = calendar(timestamp) + " " + age(timestamp, self.now).ljust(5)
                print("  " + ref.ljust(10) + " " + self.c(when, color)
                      + "  " + clip(self.cols - 34, visible(message)))

    def tags(self, rows, total):
        self.section("TAGS")
        if rows is None:
            self.fail("git for-each-ref failed")
        elif not rows:
            self.none()
        else:
            for name, timestamp, sha in rows:
                # Lightweight tags can point directly to a tree or blob, which
                # has no creator date. The tag exists even without an age.
                when = (calendar(timestamp) + " " + age(timestamp, self.now) + " ago"
                        if timestamp else "—")
                print("  " + clip(30, visible(name)).ljust(30) + " "
                      + self.c(when, "dim"))
            if total > 5:
                print("  " + self.c(f"… {total - 5} more", "dim"))

    def github_unavailable(self, state):
        color = "yellow" if "gh failed" in state or "timed out" in state else "dim"
        print("  " + self.c("(" + state + ")", color))

    def prs(self, github):
        self.section("OPEN PRS")
        if github.state:
            self.github_unavailable(github.state)
        elif not github.prs:
            self.none()
        else:
            rows = []
            for pr in github.prs:
                flag, colors = ("draft", ("dim",)) if pr["isDraft"] else ("ready", ())
                if pr["reviewDecision"] == "CHANGES_REQUESTED":
                    flag, colors = "changes req", ("red",)
                elif pr["reviewDecision"] == "APPROVED":
                    flag, colors = "approved", ("green", "bold")
                ci, ci_color = {
                    "SUCCESS": ("✓ passing", "green"),
                    "FAILURE": ("✗ failing", "red"),
                    "ERROR": ("✗ error", "red"),
                    "PENDING": ("… pending", "yellow"),
                    "EXPECTED": ("… pending", "yellow"),
                    None: ("— no checks", "dim"),
                }.get(pr["ci"], ("? unknown", "yellow"))
                rows.append((pr, flag, colors, ci, ci_color))
            numberw = max(len(str(pr["number"])) + 1 for pr in github.prs)
            flagw = max(len(flag) for _, flag, _, _, _ in rows)
            ciw = max(len(ci) for _, _, _, ci, _ in rows)
            branchw = min(24, max(8, *(len(visible(pr["headRefName"])) for pr in github.prs)),
                          max(8, self.cols - numberw - flagw - ciw - 20 - 10))
            titlew = self.cols - numberw - flagw - ciw - branchw - 10
            for pr, flag, colors, ci, ci_color in rows:
                print("  " + self.c(("#" + str(pr["number"])).ljust(numberw), "yellow") + "  "
                      + self.c(flag.ljust(flagw), *colors) + "  "
                      + self.c(ci.ljust(ciw), ci_color) + "  "
                      + self.c(clip(branchw, visible(pr["headRefName"])).ljust(branchw), "blue")
                      + "  " + clip(titlew, visible(pr["title"])))

    def issues(self, github):
        self.section("ISSUES")
        if github.state:
            self.github_unavailable(github.state)
            return
        prefix = "  " + str(github.issue_count) + " open"
        issue = github.newest_issue
        if issue is None:
            print(prefix)
            return
        prefix += "   latest: #" + str(issue["number"]) + " "
        when = " (" + age(issue["timestamp"], self.now) + " ago)"
        print(prefix + clip(self.cols - len(prefix) - len(when), visible(issue["title"]))
              + self.c(when, "dim"))

    def reflog(self, rows):
        self.section("RECENT (reflog)")
        if rows is None:
            self.fail("git reflog failed")
        elif not rows:
            self.none()
        else:
            for sha, selector, message in rows:
                match = re.search(r"@\{(\d+)(?: [^}]*)?\}$", selector)
                when = age(match.group(1), self.now) + " ago" if match else ""
                print("  " + self.c(sha.ljust(8), "yellow") + " " + self.c(when.ljust(9), "dim")
                      + " " + clip(self.cols - 22, visible(message)))


def main():
    try:
        options = parse_options(sys.argv[1:])
    except ValueError as error:
        print("git-overview: " + str(error), file=sys.stderr)
        return 2
    if options is None:
        return 0
    git = Git()
    if not git.run("rev-parse", "--git-dir").ok:
        print("git-overview: not inside a git repository", file=sys.stderr)
        return 1
    head = collect_head(git, options)
    status = git.status()
    trees = collect_worktrees(git)
    config = collect_config(git)
    branches = records(git.run("for-each-ref", "--sort=-committerdate", "refs/heads",
                       "--format=%(refname:short)%00%(committerdate:unix)%00%(upstream:short)%00%(upstream:track,nobracket)%00%(objectname:short)%00%(contents:subject)%00"), 6, ref_format=True)
    stashes = records(git.run("stash", "list", "-z", "--format=%gd%x00%ct%x00%gs"), 3)
    tags = records(git.run("for-each-ref", "--sort=-creatordate", "--count=5", "refs/tags",
                          "--format=%(refname:short)%00%(creatordate:unix)%00%(objectname:short)%00"), 3, ref_format=True)
    total_tags = len(git.run("for-each-ref", "refs/tags", "--format=x").data.splitlines())
    github = collect_github(options, head.has_remote)
    reflog = records(git.run("reflog", "-n", "6", "-z", "--date=unix", "--format=%h%x00%gd%x00%gs"), 3)
    toplevel = git.text("rev-parse", "--show-toplevel")
    renderer = Renderer(options)
    renderer.head(head)
    renderer.uncommitted(status)
    renderer.branches(branches, config, head.branch, options.branch_limit, trees)
    renderer.worktrees(trees, toplevel)
    renderer.stashes(stashes)
    renderer.tags(tags, total_tags)
    renderer.prs(github)
    renderer.issues(github)
    renderer.reflog(reflog)
    print()
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
